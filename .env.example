DATA_DIR=./data
# URL for a Qdrant server; empty = persistent embedded Qdrant (single process).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=kbtu_knowledge
# OpenAI embeddings API; keep the real key only in .env or environment variables.
OPENAI_API_KEY=
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=3
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Optional reduced dimension; default is 1536 for small, 3072 for large.
# EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=8
KBTU_CRAWLER_DELAY=1.0
KBTU_CRAWLER_CONCURRENCY=2
KBTU_CRAWLER_DEPTH=3
KBTU_CRAWLER_MAX_PAGES=100
CHUNK_TOKENS=700
CHUNK_OVERLAP=100
MAX_FILE_MB=50
OCR_ENABLED=false
OCR_LANGUAGES=rus+kaz+eng
