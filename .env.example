DATA_DIR=./data
# URL for a Qdrant server; empty = persistent embedded Qdrant (single process).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=kbtu_knowledge
# OpenAI embeddings API; keep the real key only in .env or environment variables.
OPENAI_API_KEY=
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=3
OPENAI_CHAT_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Optional reduced dimension; default is 1536 for small, 3072 for large.
# EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=8
KBTU_CRAWLER_DELAY=1.0
KBTU_CRAWLER_CONCURRENCY=2
KBTU_CRAWLER_DEPTH=3
KBTU_CRAWLER_MAX_PAGES=100
CHUNK_TOKENS=700
CHUNK_OVERLAP=100
MAX_FILE_MB=50
OCR_ENABLED=false
OCR_LANGUAGES=rus+kaz+eng
# Run python scripts/setup_ocr.py --enable to install languages and enable OCR.
# OCR_TESSDATA=./data/tessdata
# Backend retrieval and local frontend
CANDIDATES_K=20
RERANK_K=15
FINAL_K=5
RERANKER=llm
QUERY_REWRITE=true
MODERATION=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional inbox override; default is DATA_DIR/inbox/manual.
# DOCUMENTS_DIR=./data/inbox/manual

# Открытые LLM (LLaMA, Qwen) через Groq — бесплатный ключ: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODELS=qwen/qwen3.8-27b
# Локальные LLM через Ollama (необязательно) и локальные эмбеддинги sentence-transformers
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODELS=qwen2.5:1.5b,gemma3:1b,llama3.2:1b
# LOCAL_EMBEDDING_MODELS=intfloat/multilingual-e5-small,sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EVAL_JUDGE_MODEL=gpt-4o-mini

# Черновики ответов деканата на письма (n8n -> POST /api/email/reply), см. docs/EMAIL_DRAFTS.md
# Токен, который n8n передаёт в заголовке X-API-Key; пусто = без проверки (только локально).
EMAIL_API_TOKEN=
# Ящик деканата: письма с него не обрабатываются; в его «Черновики» пишутся ответы.
EMAIL_OWN_ADDRESS=
# Gmail: пароль приложения https://myaccount.google.com/apppasswords (нужна 2FA)
EMAIL_APP_PASSWORD=
# EMAIL_IMAP_HOST=imap.gmail.com
# EMAIL_IMAP_PORT=993
# Письма, полученные раньше, не обрабатываются; заполняет scripts/setup_n8n.py
# EMAIL_START_AFTER=2026-10-12T18:00:00+05:00
EMAIL_SIGNATURE="С уважением,\nДеканат КБТУ"
