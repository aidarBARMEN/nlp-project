# ===== OpenAI =====
OPENAI_API_KEY=sk-...
# Модель для генерации ответов
OPENAI_CHAT_MODEL=gpt-4o-mini
# Модель эмбеддингов (text-embedding-3-small = 1536 dim, text-embedding-3-large = 3072 dim)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ===== Vector DB (Qdrant) =====
# Пусто -> локальный встроенный Qdrant в папке QDRANT_PATH (Docker не нужен)
# http://localhost:6333 -> Qdrant-сервер (docker compose up qdrant)
QDRANT_URL=
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=kbtu_docs

# ===== Документы =====
DOCUMENTS_DIR=./data/documents

# ===== Chunking (токены tiktoken) =====
CHUNK_SIZE=600
CHUNK_OVERLAP=120

# ===== Retrieval =====
# сколько кандидатов берём из векторного и BM25 поиска
CANDIDATES_K=20
# сколько после RRF отдаём на реранкинг
RERANK_K=15
# сколько чанков попадает в промпт
FINAL_K=5
# none | llm  (llm = переранжировка через OpenAI, точнее, но +1 запрос)
RERANKER=llm
# Переписывать уточняющие вопросы с учётом истории чата
QUERY_REWRITE=true
# Проверка запросов через OpenAI Moderation API
MODERATION=false

# ===== Server =====
CORS_ORIGINS=http://localhost:5173
